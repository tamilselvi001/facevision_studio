# Copy to .env (local) or paste into your host's environment settings.
# Every value below is optional; the defaults are production-sane.

# --- Networking -------------------------------------------------------------
# Port to bind. Render and Railway inject this; Hugging Face Spaces uses 7860.
PORT=7860
# Comma-separated origins, or * . Only needed when the API and the frontend are
# deployed to DIFFERENT domains.
ALLOWED_ORIGINS=*

# --- Vision -----------------------------------------------------------------
# yunet (fastest, default) | ssd | retinaface (slowest, highest recall)
DETECTOR_BACKEND=yunet
# Cosine similarity a FaceNet embedding must reach to claim an identity.
RECOGNITION_THRESHOLD=0.60
# Combined grayscale+edge correlation floor for a template match.
TEMPLATE_MIN_SCORE=0.60
DETECTION_MIN_CONFIDENCE=0.35
# Inputs are fitted inside this box before any model runs.
MAX_IMAGE_DIM=1600
MAX_UPLOAD_MB=12

# --- Resources --------------------------------------------------------------
# Set to 0 for a classical-CV-only deployment (no TensorFlow weights needed).
DEEP_MODELS_ENABLED=1
# Load models in the background at startup instead of on first request.
WARM_UP_ON_STARTUP=1
# Point at a mounted disk to keep enrolled people across redeploys.
# GALLERY_DIR=/data/gallery

LOG_LEVEL=INFO
