# Node
node_modules/
frontend/dist/
backend/static/
.npm/
npm-debug.log*

# Generated model + embedding caches (rebuilt automatically)
backend/gallery/.embeddings.json
.deepface/
*.h5
*.caffemodel

# Downloaded/derived model weights are ignored by default, EXCEPT the two the
# app ships with -- they must be committed so builds are reproducible and cold
# starts never wait on a download.
*.onnx
!backend/models/facenet.onnx
!backend/models/yunet.onnx

